{
  "expo": {
    "name": "atls.",
    "slug": "atls",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "atls",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlas.passport",
      "buildNumber": "16",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "CFBundleDisplayName": "atls.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "atls",
              "com.googleusercontent.apps.903672843406-236ejm0d5r0tcrg762jm1od1uu181a87"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.atls.passport"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidProjectName",
      "expo-apple-authentication",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.903672843406-236ejm0d5r0tcrg762jm1od1uu181a87"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "atls. belgelerini korumak için Face ID kullanır."
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "227130ab-ebd9-49c3-b55c-33f40a547ebe"
      }
    },
    "owner": "emirhancoban"
  }
}
