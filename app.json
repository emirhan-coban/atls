{
  "expo": {
    "name": "atls.",
    "slug": "atls",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "atls",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlas.passport",
      "buildNumber": "29",
      "associatedDomains": [
        "applinks:emirhan-coban.github.io"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "CFBundleDisplayName": "atls.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "atls",
              "com.googleusercontent.apps.903672843406-236ejm0d5r0tcrg762jm1od1uu181a87"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1624",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.atls.passport"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidProjectName",
      "expo-apple-authentication",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.903672843406-236ejm0d5r0tcrg762jm1od1uu181a87"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "atls. belgelerini korumak için Face ID kullanır."
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "atls., gezilerine ve belgelerine fotoğraf eklemen için galerine erişir. Fotoğraflar yalnızca cihazında kalır.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1624",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1624",
            "image": "./assets/android-icon-foreground.png"
          }
        }
      ],
      "@sentry/react-native",
      "expo-image",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.atlas.passport",
          "widgets": [
            {
              "name": "PassportWidget",
              "displayName": "Pasaport",
              "description": "Ülke sayın ve dünyanın ne kadarını gezdiğin.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "GameWidget",
              "displayName": "Gizli Ülke",
              "description": "Günlük serin ve bugünün oyunu.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "TripWidget",
              "displayName": "Sonraki gezi",
              "description": "Bir sonraki gezine kalan gün.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "227130ab-ebd9-49c3-b55c-33f40a547ebe"
      }
    },
    "owner": "emirhancoban",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/227130ab-ebd9-49c3-b55c-33f40a547ebe",
      "fallbackToCacheTimeout": 0
    }
  }
}
