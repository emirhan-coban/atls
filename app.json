{
  "expo": {
    "name": "atls.",
    "slug": "atls",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "atls",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlas.passport",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleDarkContent",
        "CFBundleDisplayName": "atls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.atls.passport"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidProjectName",
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "227130ab-ebd9-49c3-b55c-33f40a547ebe"
      }
    },
    "owner": "emirhancoban"
  }
}
